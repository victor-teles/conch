    "render:tour": "remotion render src/index.ts ShowcaseTour out/showcase-tour.mp4",
    "capture:seed": "./capture/seed.sh"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
