    "@remotion/transitions": "4.0.545",
    "lucide-react": "^0.575.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.545"
  },
  "devDependencies": {
    "@conch/config": "workspace:*",
    "@types/node": "^25.6.0",
    "@types/react": "19.2.7",
    "@typescript/native-preview": "catalog:",
