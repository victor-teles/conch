exports[`a link notice > flashes in the footer and clears itself 1`] = `
<div
  class="pointer-events-auto flex h-8 min-w-0 items-center gap-2 rounded-full capsule-material px-3 transition-opacity duration-150 empty:pointer-events-none empty:opacity-0 motion-reduce:transition-none [&:has(>:only-child:empty)]:pointer-events-none [&:has(>:only-child:empty)]:opacity-0"
  data-slot="footer-status"
>
  <span
    aria-live="polite"
    class="flex min-w-0 items-center gap-2 empty:hidden"
    data-slot="agent-activity"
  />
  <span
    class="flex min-w-0 items-center gap-1.5"
    role="status"
  >
    <span
      class="truncate"
      data-slot="swap-text"
    >
      <span
        class="inline-block"
      >
        That link isn't one Conch understands.
      </span>
    </span>
  </span>
</div>
`;

