// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`sources section (reduced motion false) > lists servers and endpoints with their last test 1`] = `
<ul
  aria-label="Sources"
  class="flex flex-col"
>
  <li>
    <button
      aria-label="Edit Stripe"
      class="flex min-h-12 w-full items-center gap-3 px-4 py-2 text-left hover:bg-row-hover focus-visible:bg-row-hover focus-visible:ring-2 focus-visible:ring-primary/70 focus-visible:outline-none focus-visible:ring-inset"
      data-source-row="mcp:stripe"
      tabindex="0"
      type="button"
    >
      <span
        aria-label="Stripe · MCP"
        class="relative grid size-6 shrink-0 place-items-center rounded-[7px] bg-row-hover text-[12px] font-semibold text-foreground"
        data-source-kind="mcp"
        role="img"
      >
        S
        <span
          class="absolute -right-1 -bottom-1 rounded-[4px] bg-primary px-[3px] text-[7px] leading-[11px] font-bold tracking-wide text-primary-foreground"
        >
          MCP
        </span>
      </span>
      <span
        class="flex min-w-0 flex-1 flex-col"
      >
        <span
          class="truncate type-body text-foreground"
        >
          Stripe
        </span>
        <span
          class="truncate font-mono text-[11px] text-panel-muted"
        >
          /opt/homebrew/bin/npx -y @stripe/mcp
        </span>
      </span>
      <span
        class="max-w-56 shrink-0 truncate type-meta text-panel-muted"
      >
        Connected · 2 tools · 1 read
      </span>
      <svg
        aria-hidden="true"
        class="lucide lucide-chevron-right size-3.5 shrink-0 text-panel-muted"
        fill="none"
        height="24"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="m9 18 6-6-6-6"
        />
      </svg>
    </button>
  </li>
  <li>
    <button
      aria-label="Edit Status API"
      class="flex min-h-12 w-full items-center gap-3 px-4 py-2 text-left hover:bg-row-hover focus-visible:bg-row-hover focus-visible:ring-2 focus-visible:ring-primary/70 focus-visible:outline-none focus-visible:ring-inset"
      data-source-row="http:status"
      tabindex="0"
      type="button"
    >
      <span
        aria-label="Status API · HTTP"
        class="relative grid size-6 shrink-0 place-items-center rounded-[7px] bg-row-hover text-[12px] font-semibold text-foreground"
        data-source-kind="http"
        role="img"
      >
        S
        <span
          class="absolute -right-1 -bottom-1 rounded-[4px] bg-primary px-[3px] text-[7px] leading-[11px] font-bold tracking-wide text-primary-foreground"
        >
          HTTP
        </span>
      </span>
      <span
        class="flex min-w-0 flex-1 flex-col"
      >
        <span
          class="truncate type-body text-foreground"
        >
          Status API
        </span>
        <span
          class="truncate font-mono text-[11px] text-panel-muted"
        >
          https://status.example.com/api
        </span>
      </span>
      <span
        class="max-w-56 shrink-0 truncate type-meta text-danger-ink"
      >
        Status API answered 503.
      </span>
      <svg
        aria-hidden="true"
        class="lucide lucide-chevron-right size-3.5 shrink-0 text-panel-muted"
        fill="none"
        height="24"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="m9 18 6-6-6-6"
        />
      </svg>
    </button>
  </li>
</ul>
`;

exports[`sources section (reduced motion false) > shows one quiet line and both add buttons when there are no sources 1`] = `
<div>
  <div
    style="width: 760px"
  >
    <div>
      <p
        class="px-4 pt-2 pb-1 type-meta text-panel-muted"
      >
        Connect an MCP server or an HTTP API to build widgets from it.
      </p>
      <div
        class="flex gap-2 px-4 py-2.5"
      >
        <button
          class="flex h-7 items-center gap-1.5 rounded-[8px] bg-row-hover px-2.5 type-meta text-foreground hover:bg-row-active focus-visible:ring-2 focus-visible:ring-primary/70 focus-visible:outline-none"
          tabindex="0"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-plus size-3"
            fill="none"
            height="24"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M5 12h14"
            />
            <path
              d="M12 5v14"
            />
          </svg>
          Add MCP Server
        </button>
        <button
          class="flex h-7 items-center gap-1.5 rounded-[8px] bg-row-hover px-2.5 type-meta text-foreground hover:bg-row-active focus-visible:ring-2 focus-visible:ring-primary/70 focus-visible:outline-none"
          tabindex="0"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-plus size-3"
            fill="none"
            height="24"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M5 12h14"
            />
            <path
              d="M12 5v14"
            />
          </svg>
          Add HTTP Endpoint
        </button>
      </div>
    </div>
  </div>
</div>
`;

