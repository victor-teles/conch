                            >
                              <div
                                class="flex min-w-[9rem] flex-1 flex-col gap-0.5"
                              >
                                <h3
                                  class="truncate type-title text-foreground"
                                >
                                  <span
                                    data-slot="swap-text"
                                  >
                                    <span
                                      class="inline-block"
                                    >
                                      Failed charges
                                    </span>
                                  </span>
                                </h3>
                              </div>
                              <div
                                class="flex shrink-0 items-center gap-1"
                              >
                                <div
                                  aria-label="Chart view"
                                  class="flex rounded-[9px] bg-row-hover p-0.5"
                                  role="radiogroup"
                                >
                                  <button
                                    aria-checked="true"
                                    class="relative h-7 rounded-[7px] px-3 type-meta text-foreground"
                                    data-segment="table"
                                    role="radio"
                                    tabindex="0"
                                    type="button"
                                  >
                                    <span
                                      class="absolute inset-0 rounded-[7px] bg-control-thumb shadow-sm"
                                    />
                                    <span
                                      class="relative"
                                    >
                                      Table
                                    </span>
                                  </button>
                                  <button
                                    aria-checked="false"
                                    class="relative h-7 rounded-[7px] px-3 type-meta text-panel-muted"
                                    data-segment="bar"
                                    role="radio"
                                    tabindex="-1"
                                    type="button"
                                  >
                                    <span
                                      class="relative"
                                    >
                                      Bar
                                    </span>
                                  </button>
                                </div>
                              </div>
                            </div>
                            <div>
                              <div
                                class="px-2 pb-2"
                              >
                                <div
                                  class="relative max-h-[248px] overflow-auto rounded-[8px]"
                                >
                                  <table
                                    aria-label="Result rows"
                                    class="w-full border-collapse type-meta tabular-nums relative z-[1]"
                                    role="grid"
                                  >
                                    <thead
                                      class="sticky top-0 bg-(--panel-solid)"
                                    >
                                      <tr>
                                        <th
                                          class="border-b border-panel-border px-2 py-1.5 font-medium text-panel-muted text-left"
                                          scope="col"
                                        >
                                          charge_id
                                        </th>
                                        <th
                                          class="border-b border-panel-border px-2 py-1.5 font-medium text-panel-muted text-right"
                                          scope="col"
                                        >
                                          amount
                                        </th>
                                      </tr>
                                    </thead>
                                    <tbody>
                                      <tr
                                        aria-selected="false"
                                        class="hover:bg-row-hover cursor-default outline-none focus-visible:ring-1 focus-visible:ring-primary/60 focus-visible:ring-inset"
                                        tabindex="0"
                                      >
                                        <td
                                          class="max-w-64 truncate px-2 py-1 text-foreground"
                                        >
                                          ch_1
                                        </td>
                                        <td
                                          class="max-w-64 truncate px-2 py-1 text-foreground text-right"
                                        >
                                          12
                                        </td>
                                      </tr>
                                      <tr
                                        aria-selected="false"
                                        class="hover:bg-row-hover cursor-default outline-none focus-visible:ring-1 focus-visible:ring-primary/60 focus-visible:ring-inset"
                                        tabindex="-1"
                                      >
                                        <td
                                          class="max-w-64 truncate px-2 py-1 text-foreground"
                                        >
                                          ch_2
                                        </td>
                                        <td
                                          class="max-w-64 truncate px-2 py-1 text-foreground text-right"
                                        >
                                          40
                                        </td>
                                      </tr>
                                    </tbody>
                                  </table>
                                </div>
                              </div>
                            </div>
                            <div
                              class="h-3"
                            />
                          </section>
                        </div>
                      </div>
                    </article>
                  </div>
                  <div
                    class="min-w-0"
                    style="grid-column: span 6 / span 6"
                  >
                    <article
                      aria-label="Matching orders"
                      class="relative flex h-full flex-col overflow-hidden rounded-[14px] border border-panel-border bg-card outline-none focus-visible:ring-2 focus-visible:ring-primary/70"
                      data-card="orders"
                      tabindex="-1"
                    >
                      <div
                        class="flex items-center justify-between gap-3 px-4 pt-3 pb-2"
                      >
                        <h3
                          class="truncate type-title text-foreground"
                        >
                          Matching orders
                        </h3>
                      </div>
                      <div
                        aria-hidden="true"
                        class="px-4 pb-4 ask-shimmer"
                        data-testid="ask-skeleton"
                      >
                        <div
                          class="flex gap-3 pt-1 pb-3"
                        >
                          <span
                            class="h-3 rounded-full bg-foreground/[0.06]"
                            style="width: 56px"
                          />
                          <span
                            class="h-3 rounded-full bg-foreground/[0.06]"
                            style="width: 72px"
                          />
                          <span
                            class="h-3 rounded-full bg-foreground/[0.06]"
                            style="width: 48px"
                          />
                        </div>
                        <div
                          class="flex items-end gap-2 border-b border-foreground/[0.06]"
                          style="height: 200px"
                        >
                          <span
                            class="flex-1 rounded-t-[3px] bg-foreground/[0.06]"
                            style="height: 38%"
                          />
                          <span
                            class="flex-1 rounded-t-[3px] bg-foreground/[0.06]"
                            style="height: 52%"
                          />
                          <span
                            class="flex-1 rounded-t-[3px] bg-foreground/[0.06]"
                            style="height: 46%"
                          />
                          <span
                            class="flex-1 rounded-t-[3px] bg-foreground/[0.06]"
                            style="height: 61%"
                          />
                          <span
                            class="flex-1 rounded-t-[3px] bg-foreground/[0.06]"
                            style="height: 57%"
                          />
                          <span
                            class="flex-1 rounded-t-[3px] bg-foreground/[0.06]"
                            style="height: 70%"
                          />
                          <span
                            class="flex-1 rounded-t-[3px] bg-foreground/[0.06]"
                            style="height: 64%"
                          />
                          <span
                            class="flex-1 rounded-t-[3px] bg-foreground/[0.06]"
                            style="height: 73%"
                          />
                          <span
                            class="flex-1 rounded-t-[3px] bg-foreground/[0.06]"
                            style="height: 69%"
                          />
                          <span
                            class="flex-1 rounded-t-[3px] bg-foreground/[0.06]"
                            style="height: 82%"
                          />
                          <span
                            class="flex-1 rounded-t-[3px] bg-foreground/[0.06]"
                            style="height: 78%"
                          />
                          <span
                            class="flex-1 rounded-t-[3px] bg-foreground/[0.06]"
                            style="height: 88%"
                          />
                        </div>
                        <span
                          class="mt-3 block h-3 w-2/3 rounded-full bg-foreground/[0.06]"
                        />
                      </div>
                    </article>
                  </div>
                </div>
              </div>
              <div
                class="min-w-0"
              >
                <button
                  aria-disabled="true"
                  class="flex h-8 w-fit items-center gap-2 rounded-[8px] border border-panel-border bg-row-hover px-3 type-body text-foreground hover:bg-row-active focus-visible:ring-2 focus-visible:ring-primary/70 focus-visible:outline-none cursor-not-allowed opacity-60"
                  data-element="action"
                  tabindex="0"
                  title="Save the app to use its actions."
                  type="button"
                >
                  Copy region
                </button>
              </div>
            </div>
            <ul
              class="mt-3 flex flex-col gap-1 type-meta text-panel-muted"
            >
              <li>
                Review Refund.
              </li>
            </ul>
          </div>
        </div>
      </div>
      <footer
        class="pointer-events-none relative z-20 -mt-(--launcher-footer-clearance) flex h-(--launcher-footer-clearance) shrink-0 items-end gap-2 px-2 pb-2 type-meta text-panel-muted"
      >
        <div
          class="pointer-events-auto flex h-8 min-w-0 items-center gap-2 rounded-full capsule-material px-3 transition-opacity duration-150 empty:pointer-events-none empty:opacity-0 motion-reduce:transition-none [&:has(>:only-child:empty)]:pointer-events-none [&:has(>:only-child:empty)]:opacity-0"
          data-slot="footer-status"
        >
          <span
            role="status"
          >
            Ready · ⌘S to save
          </span>
        </div>
        <div
          class="pointer-events-auto ml-auto flex h-8 shrink-0 items-center gap-3 rounded-full capsule-material pr-1.5 pl-3"
          data-motion="pop"
          data-slot="footer-actions"
        >
          <div
            class="flex items-center gap-2"
          >
            <span
              class="text-foreground"
              data-slot="swap-text"
            >
              <span
                class="inline-block"
              >
                Review and Save
              </span>
            </span>
            <kbd
              aria-label="⌘ S"
              class="inline-flex items-center gap-0.5"
              data-slot="kbd-group"
            >
              <kbd
                class="pointer-events-none inline-flex h-5 min-w-5 items-center justify-center rounded-[5px] bg-kbd px-1 font-sans type-micro text-panel-muted select-none [&_svg:not([class*='size-'])]:size-3"
                data-slot="kbd"
              >
                ⌘
              </kbd>
              <kbd
                class="pointer-events-none inline-flex h-5 min-w-5 items-center justify-center rounded-[5px] bg-kbd px-1 font-sans type-micro text-panel-muted select-none [&_svg:not([class*='size-'])]:size-3"
                data-slot="kbd"
              >
                S
              </kbd>
            </kbd>
          </div>
        </div>
      </footer>
    </div>
  </div>
</div>
`;

exports[`miniAppGenerateView > shows why a build failed and offers to try again 1`] = `
<div>
  <div
    style="width: 760px"
  >
    <div
      class="flex min-h-0 flex-col"
      style="height: var(--panel-max-height)"
    >
      <header
        class="flex shrink-0 flex-col gap-0.5 px-4 pt-4 pb-3"
      >
        <h1
          class="truncate type-title text-foreground"
        >
          refund desk
        </h1>
        <p
          class="flex items-center gap-1.5 type-meta text-panel-muted"
        >
          <span
            data-slot="swap-text"
          >
            <span
              class="inline-block"
            >
              Choosing data…
            </span>
            <span
              class="inline-block"
            >
              Stopped
            </span>
          </span>
        </p>
        <p
          aria-live="polite"
          class="sr-only"
          role="status"
        />
      </header>
      <div
        class="scroll-pb-(--launcher-footer-clearance) overflow-y-auto scroll-fade min-h-0 flex-1"
      >
        <div
          class="flex min-h-full launcher-body flex-col"
        >
          <div
            class="px-4 pt-1"
          >
            <div
              class="px-4 pt-1 pb-4"
            >
              <div
                class="flex gap-3 rounded-[10px] border border-danger-ink/25 bg-destructive/[0.07] px-3 py-2.5"
                role="alert"
              >
                <svg
                  aria-hidden="true"
                  class="lucide lucide-circle-alert mt-0.5 size-4 shrink-0 text-danger-ink"
                  fill="none"
                  height="24"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  width="24"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <circle
                    cx="12"
                    cy="12"
                    r="10"
                  />
                  <line
                    x1="12"
                    x2="12"
                    y1="8"
                    y2="12"
                  />
                  <line
                    x1="12"
                    x2="12.01"
                    y1="16"
                    y2="16"
                  />
                </svg>
                <div
                  class="flex min-w-0 flex-1 flex-col gap-1"
                >
                  <p
                    class="type-body text-foreground"
                  >
                    Couldn't build a working app from that. Try naming the data you want.
                  </p>
                  <p
                    class="type-meta break-words text-panel-muted"
                  >
                    orders failed: relation missing
                  </p>
                </div>
                <button
                  class="h-7 shrink-0 self-start rounded-[7px] bg-row-hover px-2.5 type-meta text-foreground hover:bg-row-active"
                  tabindex="0"
                  type="button"
                >
                  Try Again
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <footer
        class="pointer-events-none relative z-20 -mt-(--launcher-footer-clearance) flex h-(--launcher-footer-clearance) shrink-0 items-end gap-2 px-2 pb-2 type-meta text-panel-muted"
      >
        <div
          class="pointer-events-auto flex h-8 min-w-0 items-center gap-2 rounded-full capsule-material px-3 transition-opacity duration-150 empty:pointer-events-none empty:opacity-0 motion-reduce:transition-none [&:has(>:only-child:empty)]:pointer-events-none [&:has(>:only-child:empty)]:opacity-0"
          data-slot="footer-status"
        >
          <span
            role="status"
          />
        </div>
      </footer>
    </div>
  </div>
</div>
`;
