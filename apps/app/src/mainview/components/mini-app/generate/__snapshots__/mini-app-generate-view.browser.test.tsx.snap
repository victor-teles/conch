exports[`miniAppGenerateView > gates a write action on review and the connection's opt-in 1`] = `
<section
  aria-label="Review the app"
  class="mx-3 mb-2 flex max-h-[360px] flex-col gap-3 overflow-y-auto rounded-[14px] border border-panel-border bg-card px-4 py-3"
>
  <label
    class="flex items-center gap-3"
  >
    <span
      class="w-16 shrink-0 type-meta text-panel-muted"
    >
      Name
    </span>
    <input
      aria-label="App name"
      class="h-8 min-w-0 flex-1 rounded-[8px] bg-row-hover px-2.5 type-body text-foreground outline-none focus-visible:ring-1 focus-visible:ring-primary/60"
      maxlength="60"
      value="Refund desk"
    />
  </label>
  <ul
    aria-label="Inputs"
    class="flex flex-wrap gap-1.5"
  >
    <li>
      <button
        aria-pressed="true"
        class="h-7 rounded-[7px] bg-row-hover px-2 type-meta text-foreground aria-[pressed=false]:text-panel-muted aria-[pressed=false]:line-through"
        title="Click to remove"
        type="button"
      >
        Period
      </button>
    </li>
    <li>
      <button
        aria-pressed="true"
        class="h-7 rounded-[7px] bg-row-hover px-2 type-meta text-foreground aria-[pressed=false]:text-panel-muted aria-[pressed=false]:line-through"
        title="Click to remove"
        type="button"
      >
        Region
      </button>
    </li>
  </ul>
  <ul
    aria-label="Sources"
    class="flex flex-col gap-1.5"
  >
    <li
      class="flex flex-col gap-1"
    >
      <span
        class="flex items-center gap-2 type-meta text-foreground"
      >
        charges
        <span
          class="rounded-[5px] border border-panel-border px-1.5 type-micro text-panel-muted"
        >
          SQL
        </span>
      </span>
      <pre
        class="max-h-20 overflow-auto rounded-[8px] bg-row-hover px-2 py-1.5 font-mono type-micro whitespace-pre-wrap text-panel-muted"
      >
        SELECT id AS charge_id, amount FROM charges WHERE failed_at &gt;= {{period.from}} AND failed_at &lt; {{period.to}}
      </pre>
    </li>
    <li
      class="flex flex-col gap-1"
    >
      <span
        class="flex items-center gap-2 type-meta text-foreground"
      >
        orders
        <span
          class="rounded-[5px] border border-panel-border px-1.5 type-micro text-panel-muted"
        >
          SQL
        </span>
      </span>
      <pre
        class="max-h-20 overflow-auto rounded-[8px] bg-row-hover px-2 py-1.5 font-mono type-micro whitespace-pre-wrap text-panel-muted"
      >
        SELECT id, total FROM orders WHERE region = {{region}}
      </pre>
    </li>
  </ul>
  <ul
    aria-label="Actions"
    class="flex flex-col gap-1.5"
  >
    <li
      class="flex flex-col gap-1.5 rounded-[10px] border border-panel-border px-3 py-2 opacity-70"
      data-gate="writes-off"
    >
      <div
        class="flex items-center gap-2"
      >
        <span
          class="min-w-0 flex-1 truncate type-body text-foreground"
        >
          Refund
        </span>
        <span
          class="rounded-full px-2 py-0.5 type-micro bg-warning-ink/15 text-warning-ink"
        >
          Writes
        </span>
      </div>
      <div
        class="flex flex-col gap-1.5"
      >
        <pre
          class="max-h-24 overflow-auto rounded-[8px] bg-row-hover px-2 py-1.5 font-mono type-micro break-all whitespace-pre-wrap text-foreground"
        >
          UPDATE charges SET refunded = true WHERE id = {{charge_id}}
        </pre>
        <ul
          aria-label="Values for Refund"
          class="flex flex-col gap-0.5 font-mono type-micro text-panel-muted"
        >
          <li>
            charge_id ← the row's charge_id
          </li>
        </ul>
        <p
          class="flex items-center gap-2 type-meta text-panel-muted"
        >
          Writes are off for 
          analytics
          .
          <button
            class="text-foreground underline underline-offset-2"
            type="button"
          >
            Open Settings
          </button>
        </p>
      </div>
    </li>
    <li
      class="flex flex-col gap-1.5 rounded-[10px] border border-panel-border px-3 py-2"
      data-gate="none"
    >
      <div
        class="flex items-center gap-2"
      >
        <span
          class="min-w-0 flex-1 truncate type-body text-foreground"
        >
          Copy region
        </span>
        <span
          class="rounded-full px-2 py-0.5 type-micro bg-row-hover text-panel-muted"
        >
          Read
        </span>
      </div>
    </li>
  </ul>
  <button
    aria-disabled="true"
    class="ml-auto h-8 rounded-[8px] bg-primary px-3 type-body text-primary-foreground aria-disabled:opacity-50"
    tabindex="0"
    type="button"
  >
    Save App ⌘↵
  </button>
</section>
`;

