              </span>
              <span
                class="relative flex min-w-0 items-center"
              >
                <input
                  aria-label="Region"
                  autocomplete="off"
                  class="min-w-[3ch] max-w-48 bg-transparent type-body text-foreground outline-none focus-visible:outline-none"
                  maxlength="200"
                  size="3"
                  spellcheck="false"
                  value="EU"
                />
              </span>
            </span>
          </div>
        </div>
      </div>
      <div
        class="scroll-pb-(--launcher-footer-clearance) overflow-y-auto scroll-fade min-h-0 flex-1"
      >
        <div
          class="flex min-h-full launcher-body flex-col"
        >
          <div
            class="px-4 pt-1"
          >
            <div
              class="flex min-w-0 flex-col gap-4"
              data-element="stack"
            >
              <div
                class="min-w-0"
