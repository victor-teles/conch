                  data-element="grid"
                >
                  <div
                    class="min-w-0"
                    style="grid-column: span 6 / span 6"
                  >
                    <article
                      aria-label="Failed charges"
                      class="relative flex h-full flex-col overflow-hidden rounded-[14px] border border-panel-border bg-card outline-none focus-visible:ring-2 focus-visible:ring-primary/70"
                      data-card="charges"
                      tabindex="-1"
                    >
                      <div
