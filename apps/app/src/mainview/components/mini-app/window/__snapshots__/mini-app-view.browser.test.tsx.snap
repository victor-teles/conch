exports[`miniAppView > shows a failing source inside its card 1`] = `
<article
  aria-label="Matching orders"
  class="relative flex h-full flex-col overflow-hidden rounded-[14px] border border-panel-border bg-card outline-none focus-visible:ring-2 focus-visible:ring-primary/70"
  data-card="orders"
  tabindex="-1"
>
  <div
    class="flex items-center justify-between gap-3 px-4 pt-3 pb-2"
  >
    <h3
      class="truncate type-title text-foreground"
    >
      Matching orders
    </h3>
  </div>
  <div
    class="px-4 pt-1 pb-4"
  >
    <div
      class="flex gap-3 rounded-[10px] border border-danger-ink/25 bg-destructive/[0.07] px-3 py-2.5"
      role="alert"
    >
      <svg
        aria-hidden="true"
        class="lucide lucide-circle-alert mt-0.5 size-4 shrink-0 text-danger-ink"
        fill="none"
        height="24"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <circle
          cx="12"
          cy="12"
          r="10"
        />
        <line
          x1="12"
          x2="12"
          y1="8"
          y2="12"
        />
        <line
          x1="12"
          x2="12.01"
          y1="16"
          y2="16"
        />
      </svg>
      <div
        class="flex min-w-0 flex-1 flex-col gap-1"
      >
        <p
          class="type-body text-foreground"
        >
          The query failed.
        </p>
        <p
          class="type-meta break-words text-panel-muted"
        >
          relation orders does not exist
        </p>
      </div>
      <button
        class="h-7 shrink-0 self-start rounded-[7px] bg-row-hover px-2.5 type-meta text-foreground hover:bg-row-active"
        tabindex="0"
        type="button"
      >
        Retry
      </button>
    </div>
  </div>
</article>
`;
