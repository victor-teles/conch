    <footer
      class="pointer-events-none relative z-20 -mt-(--launcher-footer-clearance) flex h-(--launcher-footer-clearance) shrink-0 items-end gap-2 px-2 pb-2 type-meta text-panel-muted"
    >
      <div
        class="pointer-events-auto flex h-8 min-w-0 items-center gap-2 rounded-full capsule-material px-3 transition-opacity duration-150 empty:pointer-events-none empty:opacity-0 motion-reduce:transition-none [&:has(>:only-child:empty)]:pointer-events-none [&:has(>:only-child:empty)]:opacity-0"
        data-slot="footer-status"
      >
        <span
          aria-live="polite"
        >
          3 runs
        </span>
      </div>
      <div
        class="pointer-events-auto ml-auto flex h-8 shrink-0 items-center gap-3 rounded-full capsule-material pr-1.5 pl-3"
        data-motion="fade"
        data-slot="footer-actions"
      >
        <div
          class="flex items-center gap-2"
        >
          <span
            class="text-foreground"
            data-slot="swap-text"
          >
            <span
              class="inline-block"
            >
              Open
            </span>
          </span>
          <kbd
            aria-label="↩"
            class="inline-flex items-center gap-0.5"
            data-slot="kbd-group"
          >
            <kbd
              class="pointer-events-none inline-flex h-5 min-w-5 items-center justify-center rounded-[5px] bg-kbd px-1 font-sans type-micro text-panel-muted select-none [&_svg:not([class*='size-'])]:size-3"
              data-slot="kbd"
            >
              ↩
            </kbd>
          </kbd>
        </div>
      </div>
    </footer>
  </div>
</div>
