      <input
        aria-activedescendant="launcher-option-x1"
        aria-label="Filter activity"
        autocomplete="off"
        class="h-8 w-full rounded-[8px] bg-row-hover px-2.5 type-body text-foreground outline-none placeholder:text-panel-muted focus-visible:ring-2 focus-visible:ring-primary/50"
        placeholder="Filter by action or target…"
        spellcheck="false"
        type="text"
        value=""
      />
    </div>
    <div
      class="min-h-0 scroll-pb-(--launcher-footer-clearance) overflow-y-auto scroll-fade flex-1"
