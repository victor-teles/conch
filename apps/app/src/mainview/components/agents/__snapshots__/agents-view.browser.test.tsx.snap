exports[`agentsView > explains the feature while it is off 1`] = `
<div>
  <div
    style="width: 760px"
  >
    <div
      class="flex min-h-0 flex-1 flex-col"
    >
      <header
        class="flex h-14 shrink-0 items-center gap-2 px-3"
      >
        <button
          aria-label="Back"
          class="grid size-7 place-items-center rounded-[8px] text-panel-muted hover:bg-row-hover hover:text-foreground"
          tabindex="0"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-chevron-left size-4"
            fill="none"
            height="24"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="m15 18-6-6 6-6"
            />
          </svg>
        </button>
        <h1
          class="min-w-0 flex-1 truncate type-title text-foreground"
        >
          Agents (MCP)
        </h1>
      </header>
      <div
        class="min-h-0 scroll-pb-(--launcher-footer-clearance) overflow-y-auto scroll-fade flex-1"
      >
        <div
          class="flex min-h-full launcher-body flex-col"
        >
          <div
            class="flex min-h-14 items-center justify-between gap-6 px-4 py-2.5"
          >
            <div
              class="flex min-w-0 flex-col gap-0.5"
            >
              <span
                class="type-body text-foreground"
              >
                Let local agents use Conch
              </span>
              <span
                class="type-meta text-panel-muted"
              >
                <span
                  aria-live="polite"
                  class=""
                >
                  <span
                    data-slot="swap-text"
                  >
                    <span
                      class="inline-block"
                    >
                      Off
                    </span>
                  </span>
                </span>
              </span>
            </div>
            <div
              class="flex shrink-0 items-center"
            >
              <span
                aria-checked="false"
                aria-label="Let local agents use Conch"
                class="peer relative flex size-4 shrink-0 items-center justify-center rounded-[4px] border border-input transition-all duration-150 ease-out outline-none group-has-disabled/field:opacity-50 after:absolute after:-inset-x-3 after:-inset-y-2 focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/20 aria-invalid:aria-checked:border-primary dark:bg-input/30 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 data-checked:border-primary data-checked:bg-primary data-checked:text-primary-foreground dark:data-checked:bg-primary"
                data-slot="checkbox"
                data-unchecked=""
                id="base-ui-_r_id_"
                role="checkbox"
                tabindex="0"
              />
              <input
                aria-hidden="true"
                style="clip-path: inset(50%); overflow: hidden; white-space: nowrap; border: 0px; padding: 0px; width: 1px; height: 1px; margin: -1px; position: fixed; top: 0px; left: 0px"
                tabindex="-1"
                type="checkbox"
              />
            </div>
          </div>
          <div
            class="flex flex-col items-start gap-3 px-4 pt-1 pb-4"
          >
            <p
              class="type-body text-panel-muted"
            >
              Claude Code, Cursor and other MCP clients on this Mac can list your connections, read schemas, ask questions and run saved widgets through Conch. Every tool is read-only, agents only see the connections you choose, passwords never leave Conch, and every call is logged.
            </p>
            <button
              class="flex h-7 items-center gap-1.5 rounded-[8px] bg-row-hover px-2.5 type-meta text-foreground hover:bg-row-active focus-visible:ring-2 focus-visible:ring-primary/70 focus-visible:outline-none"
              tabindex="0"
              type="button"
            >
              Turn on
            </button>
          </div>
        </div>
      </div>
      <footer
        class="pointer-events-none relative z-20 -mt-(--launcher-footer-clearance) flex h-(--launcher-footer-clearance) shrink-0 items-end gap-2 px-2 pb-2 type-meta text-panel-muted"
      >
        <div
          class="pointer-events-auto flex h-8 min-w-0 items-center gap-2 rounded-full capsule-material px-3 transition-opacity duration-150 empty:pointer-events-none empty:opacity-0 motion-reduce:transition-none [&:has(>:only-child:empty)]:pointer-events-none [&:has(>:only-child:empty)]:opacity-0"
          data-slot="footer-status"
        >
          <span
            data-slot="swap-text"
          >
            <span
              class="inline-block"
            >
              Off
            </span>
          </span>
        </div>
        <div
          class="pointer-events-auto ml-auto flex h-8 shrink-0 items-center gap-3 rounded-full capsule-material pr-1.5 pl-3"
          data-motion="pop"
          data-slot="footer-actions"
        >
          <div
            class="flex items-center gap-2"
          >
            <span
              class="text-foreground"
              data-slot="swap-text"
            >
              <span
                class="inline-block"
              >
                Back
              </span>
            </span>
            <kbd
              aria-label="esc"
              class="inline-flex items-center gap-0.5"
              data-slot="kbd-group"
            >
              <kbd
                class="pointer-events-none inline-flex h-5 min-w-5 items-center justify-center rounded-[5px] bg-kbd px-1 font-sans type-micro text-panel-muted select-none [&_svg:not([class*='size-'])]:size-3"
                data-slot="kbd"
              >
                esc
              </kbd>
            </kbd>
          </div>
        </div>
      </footer>
    </div>
  </div>
</div>
`;

