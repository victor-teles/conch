exports[`auditView > lists calls newest first with client, tool, connection and outcome 1`] = `
<div>
  <script
    nonce=""
  >
    ((e, i, s, u, m, a, l, h) =&gt; {
  let d = document.documentElement, w = ["light", "dark"];
  function p(n) {
    (Array.isArray(e) ? e : [e]).forEach((y) =&gt; {
      let k = y === "class", S = k && a ? m.map((f) =&gt; a[f] || f) : m;
      k ? (d.classList.remove(...S), d.classList.add(a && a[n] ? a[n] : n)) : d.setAttribute(y, n);
    }), R(n);
  }
  function R(n) {
    h && w.includes(n) && (d.style.colorScheme = n);
  }
  function c() {
    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  }
  if (u) p(u);
  else try {
    let n = localStorage.getItem(i) || s, y = l && n === "system" ? c() : n;
    p(y);
  } catch (n) {
  }
})("class","vite-ui-theme","dark",null,["light","dark"],null,true,true)
  </script>
  <div
    style="width: 760px"
  >
    <div
      class="flex min-h-0 flex-1 flex-col"
    >
      <header
        class="flex h-14 shrink-0 items-center gap-2 px-3"
      >
        <button
          aria-label="Back"
          class="grid size-7 place-items-center rounded-[8px] text-panel-muted hover:bg-row-hover hover:text-foreground"
          tabindex="0"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-chevron-left size-4"
            fill="none"
            height="24"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="m15 18-6-6 6-6"
            />
          </svg>
        </button>
        <h1
          class="min-w-0 flex-1 truncate type-title text-foreground"
        >
          Agent activity
        </h1>
        <button
          class="flex h-7 shrink-0 items-center rounded-[8px] px-2.5 type-meta focus-visible:ring-2 focus-visible:ring-primary/70 focus-visible:outline-none text-panel-muted hover:bg-row-hover hover:text-foreground"
          tabindex="0"
          type="button"
        >
          <span
            data-slot="swap-text"
          >
            <span
              class="inline-block"
            >
              Clear activity
            </span>
          </span>
        </button>
      </header>
      <div
        class="relative flex min-h-0 flex-1 flex-col"
        style="min-height: 0px"
      >
        <div
          class="min-h-0 scroll-pb-(--launcher-footer-clearance) overflow-y-auto scroll-fade flex-1"
        >
          <div
            class="flex min-h-full launcher-body flex-col"
          >
            <div
              aria-activedescendant="launcher-option-audit-1"
              aria-label="Agent calls"
              class="flex flex-col gap-1 px-2 py-2 outline-none focus-visible:ring-2 focus-visible:ring-primary/50"
              id="launcher-agents-audit"
              role="listbox"
              tabindex="0"
            >
              <div
                data-motion="stagger"
              >
                <div
                  aria-selected="true"
                  class="relative flex cursor-default items-center gap-3 px-2.5 h-14"
                  data-tone="default"
                  id="launcher-option-audit-1"
                  role="option"
                  tabindex="0"
                >
                  <div
                    class="absolute inset-0 rounded-[10px] bg-row-active"
                  />
                  <span
                    class="relative flex min-w-0 flex-1 flex-col gap-0.5"
                  >
                    <span
                      class="truncate type-body text-foreground"
                    >
                      Revenue by region
                    </span>
                    <span
                      class="truncate type-meta tabular-nums text-panel-muted"
                      data-outcome="ok"
                    >
                      9:41 AM · Claude Code · ask · analytics · 27 rows · 1.2 s
                    </span>
                  </span>
                </div>
              </div>
              <div
                data-motion="stagger"
              >
                <div
                  aria-selected="false"
                  class="relative flex cursor-default items-center gap-3 px-2.5 h-14"
                  data-tone="default"
                  id="launcher-option-audit-2"
                  role="option"
                  tabindex="0"
                >
                  <span
                    class="relative flex min-w-0 flex-1 flex-col gap-0.5"
                  >
                    <span
                      class="truncate type-body text-foreground"
                    >
                      Listed connections
                    </span>
                    <span
                      class="truncate type-meta tabular-nums text-danger-ink"
                      data-outcome="limited"
                    >
                      9:40 AM · Claude Code · list_connections · limited · 0 ms
                    </span>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <footer
        class="pointer-events-none relative z-20 -mt-(--launcher-footer-clearance) flex h-(--launcher-footer-clearance) shrink-0 items-end gap-2 px-2 pb-2 type-meta text-panel-muted"
      >
        <div
          class="pointer-events-auto flex h-8 min-w-0 items-center gap-2 rounded-full capsule-material px-3 transition-opacity duration-150 empty:pointer-events-none empty:opacity-0 motion-reduce:transition-none [&:has(>:only-child:empty)]:pointer-events-none [&:has(>:only-child:empty)]:opacity-0"
          data-slot="footer-status"
        >
          <span
            aria-live="polite"
          >
            2 agent calls
          </span>
        </div>
        <div
          class="pointer-events-auto ml-auto flex h-8 shrink-0 items-center gap-3 rounded-full capsule-material pr-1.5 pl-3"
          data-motion="pop"
          data-slot="footer-actions"
        >
          <div
            class="flex items-center gap-2"
          >
            <span
              class="text-foreground"
              data-slot="swap-text"
            >
              <span
                class="inline-block"
              >
                Copy SQL
              </span>
            </span>
            <kbd
              aria-label="↩"
              class="inline-flex items-center gap-0.5"
              data-slot="kbd-group"
            >
              <kbd
                class="pointer-events-none inline-flex h-5 min-w-5 items-center justify-center rounded-[5px] bg-kbd px-1 font-sans type-micro text-panel-muted select-none [&_svg:not([class*='size-'])]:size-3"
                data-slot="kbd"
              >
                ↩
              </kbd>
            </kbd>
          </div>
          <div
            class="flex items-center gap-2 border-l border-panel-border pl-3"
          >
            <span>
              Actions
            </span>
            <kbd
              aria-label="⌘ K"
              class="inline-flex items-center gap-0.5"
              data-slot="kbd-group"
            >
              <kbd
                class="pointer-events-none inline-flex h-5 min-w-5 items-center justify-center rounded-[5px] bg-kbd px-1 font-sans type-micro text-panel-muted select-none [&_svg:not([class*='size-'])]:size-3"
                data-slot="kbd"
              >
                ⌘
              </kbd>
              <kbd
                class="pointer-events-none inline-flex h-5 min-w-5 items-center justify-center rounded-[5px] bg-kbd px-1 font-sans type-micro text-panel-muted select-none [&_svg:not([class*='size-'])]:size-3"
                data-slot="kbd"
              >
                K
              </kbd>
            </kbd>
          </div>
        </div>
      </footer>
    </div>
  </div>
</div>
`;

