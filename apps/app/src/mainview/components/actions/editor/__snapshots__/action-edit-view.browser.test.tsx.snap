            <button
              aria-checked="false"
              class="relative h-7 rounded-[7px] px-3 type-meta text-panel-muted"
              data-segment="copy"
              role="radio"
              tabindex="-1"
              type="button"
            >
              <span
                class="relative"
              >
                Copy
              </span>
            </button>
          </div>
        </div>
      </div>
      <div>
        <div
          class="relative"
        >
          <div
            class="flex items-start gap-3 px-4 py-1.5"
          >
            <span
              class="w-24 shrink-0 pt-1.5 type-meta text-panel-muted"
            >
              Endpoint
            </span>
            <div
              class="flex min-w-0 flex-1 flex-col gap-1"
            >
              <select
                aria-label="Endpoint"
                class="h-8 w-full min-w-0 rounded-[8px] border border-panel-border bg-row-hover px-2.5 text-[12px] text-foreground outline-none placeholder:font-sans placeholder:text-panel-muted focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 font-sans"
              />
            </div>
          </div>
          <div
            class="flex items-start gap-3 px-4 py-1.5"
          >
            <span
              class="w-24 shrink-0 pt-1.5 type-meta text-panel-muted"
            >
              Request
            </span>
            <div
              class="flex min-w-0 flex-1 flex-col gap-1"
            >
              <div
                class="flex gap-2"
              >
                <select
                  aria-label="Method"
                  class="h-8 min-w-0 rounded-[8px] border border-panel-border bg-row-hover px-2.5 text-[12px] text-foreground outline-none placeholder:font-sans placeholder:text-panel-muted focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 font-sans w-28 shrink-0"
                >
                  <option
                    value="GET"
                  >
                    GET
                  </option>
                  <option
                    value="POST"
                  >
                    POST
                  </option>
                  <option
                    value="PUT"
                  >
                    PUT
                  </option>
                  <option
                    value="PATCH"
                  >
                    PATCH
                  </option>
                  <option
                    value="DELETE"
                  >
                    DELETE
                  </option>
                </select>
                <input
                  aria-label="Path"
                  autocapitalize="off"
                  autocomplete="off"
                  class="h-8 w-full min-w-0 rounded-[8px] border border-panel-border bg-row-hover px-2.5 font-mono text-[12px] text-foreground outline-none placeholder:font-sans placeholder:text-panel-muted focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40"
                  placeholder="/tickets/{{id}}/close"
                  spellcheck="false"
                  type="text"
                  value="/"
                />
              </div>
            </div>
          </div>
          <div
            class="flex items-start gap-3 px-4 py-1.5"
          >
            <span
              class="w-24 shrink-0 pt-1.5 type-meta text-panel-muted"
            >
              Body
            </span>
            <div
              class="flex min-w-0 flex-1 flex-col gap-1"
            >
              <textarea
                aria-label="Body"
                autocapitalize="off"
                autocomplete="off"
                class="w-full min-w-0 rounded-[8px] border border-panel-border bg-row-hover px-2.5 font-mono text-[12px] text-foreground outline-none placeholder:font-sans placeholder:text-panel-muted focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 h-auto min-h-[76px] resize-y py-2 leading-[18px] whitespace-pre-wrap"
                rows="4"
                spellcheck="false"
              />
              <span
                class="type-micro text-panel-muted"
              >
                JSON, or leave empty.
              </span>
            </div>
          </div>
        </div>
        <div
          class="relative"
        >
          <p
            class="px-4 py-2 type-meta text-panel-muted"
          >
            Add a 
            {{value}}
             to bind a row column, an input or fixed text.
          </p>
        </div>
      </div>
    </div>
    <footer
      class="pointer-events-none relative z-20 -mt-(--launcher-footer-clearance) flex h-(--launcher-footer-clearance) shrink-0 items-end gap-2 px-2 pb-2 type-meta text-panel-muted"
    >
      <div
        class="pointer-events-auto flex h-8 min-w-0 items-center gap-2 rounded-full capsule-material px-3 transition-opacity duration-150 empty:pointer-events-none empty:opacity-0 motion-reduce:transition-none [&:has(>:only-child:empty)]:pointer-events-none [&:has(>:only-child:empty)]:opacity-0"
        data-slot="footer-status"
      >
        <span
          aria-live="polite"
          class="truncate"
        >
          <span
            data-slot="swap-text"
          >
            <span
              class="inline-block"
            >
              Give the action a label.
            </span>
          </span>
        </span>
      </div>
      <div
        class="pointer-events-auto ml-auto flex h-8 shrink-0 items-center gap-3 rounded-full capsule-material pr-1.5 pl-3"
        data-motion="pop"
        data-slot="footer-actions"
      >
        <div
          class="flex items-center gap-2"
        >
          <span>
            Suggest
          </span>
          <kbd
            aria-label="⌘ ⇧ S"
            class="inline-flex items-center gap-0.5"
            data-slot="kbd-group"
          >
            <kbd
              class="pointer-events-none inline-flex h-5 min-w-5 items-center justify-center rounded-[5px] bg-kbd px-1 font-sans type-micro text-panel-muted select-none [&_svg:not([class*='size-'])]:size-3"
              data-slot="kbd"
            >
              ⌘
            </kbd>
            <kbd
              class="pointer-events-none inline-flex h-5 min-w-5 items-center justify-center rounded-[5px] bg-kbd px-1 font-sans type-micro text-panel-muted select-none [&_svg:not([class*='size-'])]:size-3"
              data-slot="kbd"
            >
              ⇧
            </kbd>
            <kbd
              class="pointer-events-none inline-flex h-5 min-w-5 items-center justify-center rounded-[5px] bg-kbd px-1 font-sans type-micro text-panel-muted select-none [&_svg:not([class*='size-'])]:size-3"
              data-slot="kbd"
            >
              S
            </kbd>
          </kbd>
        </div>
      </div>
    </footer>
  </div>
</div>
`;

