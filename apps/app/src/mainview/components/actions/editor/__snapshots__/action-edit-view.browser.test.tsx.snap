              placeholder="Mark shipped"
              spellcheck="false"
              type="text"
              value=""
            />
          </div>
        </div>
      </div>
      <div
        class="flex items-start gap-3 px-4 py-1.5"
      >
        <span
          class="w-24 shrink-0 pt-1.5 type-meta text-panel-muted"
        >
          Acts on
        </span>
        <div
          class="flex min-w-0 flex-1 flex-col gap-1"
        >
          <div
            aria-label="Acts on"
            class="flex rounded-[9px] bg-row-hover p-0.5"
            role="radiogroup"
          >
            <button
              aria-checked="true"
              class="relative h-7 rounded-[7px] px-3 type-meta text-foreground"
              data-segment="row"
              role="radio"
              tabindex="0"
              type="button"
            >
              <span
                class="absolute inset-0 rounded-[7px] bg-control-thumb shadow-sm"
              />
              <span
                class="relative"
              >
                A row
              </span>
            </button>
            <button
              aria-checked="false"
              class="relative h-7 rounded-[7px] px-3 type-meta text-panel-muted"
              data-segment="widget"
              role="radio"
              tabindex="-1"
              type="button"
            >
              <span
                class="relative"
              >
                The widget
              </span>
            </button>
          </div>
        </div>
      </div>
      <div
        class="flex items-start gap-3 px-4 py-1.5"
      >
        <span
          class="w-24 shrink-0 pt-1.5 type-meta text-panel-muted"
        >
          Does
        </span>
        <div
          class="flex min-w-0 flex-1 flex-col gap-1"
        >
          <div
            aria-label="Target"
            class="flex rounded-[9px] bg-row-hover p-0.5"
            role="radiogroup"
          >
            <button
              aria-checked="false"
              class="relative h-7 rounded-[7px] px-3 type-meta text-panel-muted"
              data-segment="sql"
              role="radio"
              tabindex="-1"
              type="button"
            >
