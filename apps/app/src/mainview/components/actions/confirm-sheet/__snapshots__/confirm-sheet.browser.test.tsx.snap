            <kbd
              aria-label="esc"
              class="inline-flex items-center gap-0.5"
              data-slot="kbd-group"
            >
              <kbd
                class="pointer-events-none inline-flex h-5 min-w-5 items-center justify-center rounded-[5px] bg-kbd px-1 font-sans type-micro text-panel-muted select-none [&_svg:not([class*='size-'])]:size-3"
                data-slot="kbd"
              >
                esc
              </kbd>
            </kbd>
          </button>
          <div>
            <button
              aria-disabled="true"
              aria-keyshortcuts="Meta+Enter"
              class="flex h-8 items-center gap-2 rounded-[8px] px-3 type-body outline-none focus-visible:ring-2 focus-visible:ring-primary/70 bg-warning-ink text-background hover:opacity-90"
              data-testid="confirm-write"
              tabindex="0"
              type="button"
            >
              <span
                data-slot="swap-text"
              >
                <span
                  class="inline-block"
                >
                  Running…
                </span>
              </span>
              <kbd
                aria-label="⌘ ↩"
                class="inline-flex items-center gap-0.5 text-background/80"
                data-slot="kbd-group"
              >
                <kbd
                  class="pointer-events-none inline-flex h-5 min-w-5 items-center justify-center rounded-[5px] bg-kbd px-1 font-sans type-micro text-panel-muted select-none [&_svg:not([class*='size-'])]:size-3"
                  data-slot="kbd"
                >
                  ⌘
                </kbd>
                <kbd
                  class="pointer-events-none inline-flex h-5 min-w-5 items-center justify-center rounded-[5px] bg-kbd px-1 font-sans type-micro text-panel-muted select-none [&_svg:not([class*='size-'])]:size-3"
                  data-slot="kbd"
                >
                  ↩
                </kbd>
              </kbd>
            </button>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>
`;
