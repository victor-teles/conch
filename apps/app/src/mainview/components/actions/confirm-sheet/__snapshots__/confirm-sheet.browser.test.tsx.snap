exports[`confirmSheet > announces a completed write and copies the outcome with ⌘C 1`] = `
<div>
  <div
    style="height: 480px; position: relative; width: 760px"
  >
    <div
      aria-describedby="action-confirm-description"
      aria-labelledby="_r_id_"
      aria-modal="true"
      class="absolute inset-0 z-40 flex flex-col justify-end"
      role="alertdialog"
    >
      <div
        aria-hidden="true"
        class="absolute inset-0 bg-(--panel-solid)"
      />
      <section
        class="relative flex max-h-full flex-col overflow-y-auto rounded-t-[14px] popover-material px-4 pt-3 pb-14"
        data-motion="slide"
      >
        <header
          class="flex items-center gap-2 pb-2"
        >
          <h2
            class="min-w-0 flex-1 truncate type-title text-foreground"
            id="_r_id_"
          >
            Mark reviewed
          </h2>
          <span
            class="rounded-full bg-warning-ink/15 px-2 py-0.5 type-micro text-warning-ink"
          >
            Writes
          </span>
        </header>
        <div>
          <div
            class="flex items-center gap-2 px-1 py-3 type-body text-foreground"
          >
            <svg
              aria-label="Done"
              class="text-success-ink size-4"
              fill="none"
              role="img"
              viewBox="0 0 16 16"
            >
              <path
                d="M3.5 8.5 6.5 11.5 12.5 4.5"
                pathLength="1"
                stroke="currentColor"
                stroke-dasharray="1 1"
                stroke-dashoffset="0"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.75"
              />
            </svg>
            <span>
              1 row changed · 42 ms
            </span>
          </div>
        </div>
        <p
          aria-live="polite"
          class="sr-only"
          role="status"
        >
          Write completed: 1 row changed
        </p>
        <div
          class="flex items-center justify-end gap-2 pt-3"
        >
          <button
            class="flex h-8 items-center gap-2 rounded-[8px] px-3 type-body outline-none focus-visible:ring-2 focus-visible:ring-primary/70 bg-row-hover text-foreground hover:bg-row-active"
            tabindex="0"
            type="button"
          >
            Done
            <kbd
              aria-label="esc"
              class="inline-flex items-center gap-0.5"
              data-slot="kbd-group"
            >
              <kbd
                class="pointer-events-none inline-flex h-5 min-w-5 items-center justify-center rounded-[5px] bg-kbd px-1 font-sans type-micro text-panel-muted select-none [&_svg:not([class*='size-'])]:size-3"
                data-slot="kbd"
              >
                esc
              </kbd>
            </kbd>
          </button>
        </div>
      </section>
    </div>
  </div>
</div>
`;

